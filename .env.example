# Postgres connection string (Vercel Postgres / Neon). Use the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Vercel Blob store token (Vercel dashboard -> Storage -> your Blob store -> .env.local tab)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

ADMIN_PASSWORD="change-me-please"
SESSION_SECRET="generate-with-node-crypto-randomBytes-32-hex"

NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXXX"
